{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build C MPI Program",
            "command": "gcc",
            "args": [
                "-g",
                "${fileBasename}",
                "-o",
                "${fileBasenameNoExtension}.exe",
                "-I",
                "C:\\Program Files (x86)\\Microsoft SDKs\\MPI\\Include",
                "-L",
                "C:\\Program Files (x86)\\Microsoft SDKs\\MPI\\Lib\\x64",
                "-lmsmpi"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
